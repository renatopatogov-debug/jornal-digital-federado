# =============================================================================
# JORNAL DIGITAL FEDERADO — VARIÁVEIS DE AMBIENTE (.env)
# =============================================================================

# Configurações do Servidor HTTP (Rust / Axum)
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,jornal_backend=debug

# Conexão com Banco de Dados Relacional (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jornal_federado
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Conexão com Memória Cache & Rate Limit (Redis 7)
REDIS_URL=redis://127.0.0.1:6379

# Segurança & Criptografia (ADR D8)
# Chave mestra de 32 bytes (256 bits) codificada em Base64 para Envelope AES-256-GCM dos 2FA TOTP
AES_256_GCM_MASTER_KEY=U0VNUEJBTkNBREFTRUdVUkFOQ0ExMjM0NTY3ODkwMTI=
SESSION_SECRET_SALT=chave_secreta_longa_para_hashing_de_cookies_http_only_2026

# Feature Flags & Conformidade Legal (ADR D6)
MODO_ELEITORAL_DEFAULT=false

# Limites Operacionais de Segurança
MAX_ATIVACAO_SEMANAL_LIDER_MUNICIPAL=50
RATE_LIMIT_VOTOS_POR_MINUTO=10
